/* Research popup — full-screen overlay (no center card). 2x2 slot grid. */

.popup-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(48, 36, 22);
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.22s ease-out;
    display: none;
}

.popup-root.open {
    opacity: 1;
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 38px;
    padding-bottom: 18px;
    padding-left: 32px;
    padding-right: 24px;
    border-bottom-width: 3px;
    border-bottom-color: rgb(90, 55, 20);
    background-color: rgb(38, 28, 16);
}

.header-title {
    -unity-font-style: bold;
    font-size: 44px;
    color: rgb(255, 240, 210);
    flex-grow: 1;
}

/* Themed Raven icon shown next to a popup title. */
.title-icon {
    width: 56px;
    height: 56px;
    margin-right: 18px;
    -unity-background-scale-mode: scale-to-fit;
}

.title-icon--book {
    background-image: url("project://database/Assets/Sprites/UI/Icons/Raven/Misc_Books.png");
}

.close-button {
    width: 72px;
    height: 72px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Sprites/UI/UI_Wood/UI_Wood_Cross_Medium.png");
    -unity-background-scale-mode: scale-to-fit;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding: 0;
    color: rgba(0, 0, 0, 0);
}

.close-button:hover { opacity: 0.85; }

/* ─── Vertical list of 4 slots ─── */

.slots-list {
    flex-grow: 1;
    flex-direction: column;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 32px;
    padding-right: 32px;
}

.slot-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: rgb(72, 56, 36);
    border-color: rgb(110, 86, 50);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
}

/* ─── Slot states ─── */

.slot-card--unlocked-empty {
    background-color: rgb(86, 68, 42);
    border-color: rgb(170, 138, 80);
}

.slot-card--locked {
    background-color: rgb(50, 40, 26);
    border-color: rgba(110, 86, 50, 0.45);
    opacity: 0.85;
}

.slot-card--affordable {
    background-color: rgb(96, 76, 48);
    border-color: rgb(220, 180, 100);
}

.slot-card--pressed {
    background-color: rgb(56, 44, 28);
    border-color: rgb(170, 138, 80);
}

/* ─── Slot labels (built in code, styled here) ─── */

.slot-status {
    -unity-font-style: bold;
    font-size: 38px;
    color: rgb(220, 195, 150);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    white-space: normal;
}

.slot-action {
    font-size: 28px;
    color: rgb(255, 240, 210);
    -unity-text-align: middle-center;
    white-space: normal;
}

.slot-card--locked .slot-status {
    color: rgba(220, 195, 150, 0.75);
}

.slot-card--locked .slot-action {
    color: rgba(255, 240, 210, 0.65);
}

.slot-card--affordable .slot-status {
    color: rgb(255, 240, 210);
}

/* ─── Locked-slot lock icon + currency cost row ─── */

.slot-lock-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/Sprites/UI/Icons/Raven/Misc_KeyOrange.png");
    -unity-background-scale-mode: scale-to-fit;
}

.slot-action-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-cost-icon--gem,
.slot-cost-icon--coin {
    width: 32px;
    height: 32px;
    margin-left: 6px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-cost-icon--gem {
    background-image: url("project://database/Assets/Sprites/UI/Icons/Icons_Essential/Gem.png");
}

.slot-cost-icon--coin {
    background-image: url("project://database/Assets/Sprites/UI/Icons/Icons_Essential/Coin.png");
}

/* ─── Picker overlay (top-level — sibling of popup-root, NOT child of it) ─── */

.picker {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(28, 20, 12);
    flex-direction: column;
    padding-top: 38px;
    padding-bottom: 18px;
    padding-left: 24px;
    padding-right: 24px;
}

.picker-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom-width: 3px;
    border-bottom-color: rgb(90, 55, 20);
}

.picker-header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.picker-title {
    font-size: 40px;
    color: rgb(255, 240, 210);
    -unity-font-style: bold;
    flex-shrink: 1;
}

/* Coin balance chip so the player can see what they can afford while picking. */
.picker-coins {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 22px;
    padding-left: 14px;
    padding-right: 16px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(0, 0, 0, 0.28);
    border-radius: 18px;
}

.picker-coins__icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/UI/Icons/Icons_Essential/Coin.png");
}

.picker-coins__amount {
    font-size: 30px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
}

.picker-close {
    width: 72px;
    height: 72px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(220, 195, 150);
    font-size: 32px;
    -unity-font-style: bold;
    border-width: 0;
}

.picker-list {
    flex-grow: 1;
}

/* Branch section header inside the scrolling list */
.picker-section {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(110, 86, 50);
}

.picker-section--first {
    margin-top: 0;
}

/* Branch icon; the sprite is assigned in code from Resources/Research/BranchIcons.
   32px keeps the 16px source art on a clean 2x integer scale. */
.picker-section__icon {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
}

.picker-section__title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 220, 140);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.picker-section__count {
    font-size: 18px;
    color: rgb(160, 145, 110);
}

/* Picker rows */

.picker-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    margin-bottom: 10px;
    background-color: rgba(255, 240, 210, 0.06);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-color: rgba(255, 240, 210, 0.06);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.picker-row__text-col {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.picker-row__name {
    color: rgb(255, 240, 210);
    font-size: 24px;
    -unity-font-style: bold;
}

.picker-row__desc {
    color: rgb(180, 165, 130);
    font-size: 22px;
    white-space: normal;
    margin-top: 4px;
}

.picker-row__meta-col {
    flex-direction: column;
    align-items: flex-end;
    min-width: 130px;
    margin-left: 16px;
}

.picker-row__cost {
    color: rgb(240, 200, 120);
    font-size: 22px;
    -unity-font-style: bold;
}

.picker-row__time {
    color: rgb(200, 180, 140);
    font-size: 18px;
    margin-top: 4px;
}

/* Unaffordable: dimmed, cost red */
.picker-row--disabled {
    background-color: rgba(255, 240, 210, 0.03);
    opacity: 0.65;
}

.picker-row--disabled .picker-row__name { color: rgb(140, 128, 100); }
.picker-row--disabled .picker-row__desc { color: rgb(110, 100, 80); }
.picker-row__cost--unaffordable { color: rgb(220, 90, 90); }

/* Maxed: gold tint + gold border */
.picker-row--complete {
    background-color: rgba(240, 200, 120, 0.14);
    border-color: rgb(240, 200, 120);
}

.picker-row--complete .picker-row__name { color: rgb(240, 200, 120); }
.picker-row--complete .picker-row__cost { color: rgb(240, 200, 120); }
.picker-row--complete .picker-row__time { color: rgb(240, 200, 120); }

/* Resume (paid-but-paused): green tint to signal "no charge, time-remaining only" */
.picker-row--resume {
    background-color: rgba(140, 200, 100, 0.10);
    border-color: rgb(140, 200, 100);
}
.picker-row__cost--resume { color: rgb(140, 200, 100); }
.picker-row__time--resume { color: rgb(140, 200, 100); }

/* Active (this research is currently running in one of the slots) — bright green tint + border */
.picker-row--active {
    background-color: rgba(140, 200, 100, 0.16);
    border-color: rgb(140, 200, 100);
}
.picker-row--active .picker-row__name { color: rgb(255, 240, 210); }
.picker-row__cost--active {
    color: rgb(140, 200, 100);
    -unity-font-style: bold;
}
.picker-row__time--active {
    color: rgb(140, 200, 100);
    -unity-font-style: bold;
}

/* ─── Active slot timer view ─── */

.slot-card__active-name {
    color: rgb(255, 240, 210);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.slot-card__active-progress {
    height: 14px;
    margin-top: 12px;
    background-color: rgba(255, 240, 210, 0.12);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    width: 88%;
}

.slot-card__active-progress-fill {
    height: 100%;
    background-color: rgb(140, 200, 100);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.slot-card__active-timer {
    color: rgb(220, 195, 150);
    font-size: 32px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* The centre column of an active cell. Corner controls are absolute, so this stays centred. */
.slot-card__active-body {
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 62px;    /* clear the Auto toggle */
    margin-bottom: 58px; /* clear Cancel / Speed Up */
}

/* ─── Active cell corner controls ─── */

.slot-card__corner--pressed {
    opacity: 0.6;
}

/* Top-left: Auto (repeat) toggle */
.slot-card__auto {
    position: absolute;
    top: 16px;
    left: 18px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(0, 0, 0, 0.22);
    border-color: rgba(255, 240, 210, 0.22);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.slot-card__auto-icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Sprites/UI/Icons/Icons_Essential/Restart.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.45;
}

.slot-card__auto-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(255, 240, 210, 0.5);
}

/* On state — green to match the research/compost family used elsewhere in this popup. */
.slot-card__auto--on {
    background-color: rgba(90, 150, 60, 0.35);
    border-color: rgb(140, 200, 100);
}

.slot-card__auto--on .slot-card__auto-icon {
    opacity: 1;
}

.slot-card__auto--on .slot-card__auto-label {
    color: rgb(170, 225, 120);
}

/* Bottom-left: Cancel */
.slot-card__cancel {
    position: absolute;
    bottom: 18px;
    left: 14px;
    color: rgb(200, 110, 110);
    font-size: 22px;
    -unity-text-align: middle-center;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* Bottom-right: compost speed-up chip */
.slot-card__boost-chip {
    position: absolute;
    bottom: 16px;
    right: 18px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(0, 0, 0, 0.22);
    border-color: rgba(255, 240, 210, 0.22);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.slot-card__boost-chip--active {
    background-color: rgba(90, 150, 60, 0.35);
    border-color: rgb(140, 200, 100);
}

.slot-card__compost-icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Sprites/UI/Icons/Icons_Essential/Compost.png");
    -unity-background-scale-mode: scale-to-fit;
}

.slot-card__boost-mult {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(200, 175, 135);
}

.slot-card__boost-chip--active .slot-card__boost-mult {
    width: 38px;
    -unity-text-align: middle-left;
}

.slot-card__boost-chip--active .slot-card__boost-mult {
    color: rgb(170, 225, 120);
}

/* Real-world remaining time on the boost — quieter than the multiplier beside it.
   Fixed width (fits "11h 59m 59s", the longest a 12hr token can show) so the pill
   never resizes as it counts down. */
.slot-card__boost-left {
    font-size: 20px;
    width: 148px;
    margin-left: 8px;
    -unity-text-align: middle-left;
    color: rgba(255, 240, 210, 0.8);
}

/* Top-right: gem Finish-now — the purple twin of the green compost chip (bottom-right). */
.slot-card__gem-chip {
    position: absolute;
    top: 16px;
    right: 18px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(140, 70, 210, 0.35);
    border-color: rgb(190, 130, 255);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.slot-card__gem-icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Sprites/UI/Icons/Icons_Essential/Gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.slot-card__gem-cost {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(225, 195, 255);
}

/* Armed (waiting for the confirming second tap): brighter fill. */
.slot-card__gem-chip--armed {
    background-color: rgba(150, 80, 230, 0.75);
}

.slot-card__gem-chip--armed .slot-card__gem-cost {
    color: rgb(255, 255, 255);
}

/* Can't afford: dimmed, like a disabled compost row. */
.slot-card__gem-chip--short {
    opacity: 0.5;
}
